{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "concurrent",
  "properties": {
    "token": {
      "description": "token",
      "type": "string"
    },
    "timestamp": {
      "description": "timestamp",
      "type": "string"
    },
    "taskID": {
      "description": "taskID",
      "type": "string"
    },
    "prio": {
      "description": "prio",
      "type": "string"
    },
    "acqAddr": {
      "description": "acqAddr",
      "type": "string",
      "minLength": 12,
      "maxLength": 12
    },
    "proType": {
      "description": "proType",
      "type": "string",
      "enum": ["00", "01", "02", "03"]
    },
    "data": {
      "description": "data",
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2})+$"
    }
  },
  "required": [
    "token",
    "timestamp",
    "taskID",
    "prio",
    "acqAddr",
    "proType",
    "data"
  ],
  "type": "object"
}
