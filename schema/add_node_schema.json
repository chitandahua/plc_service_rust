{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "add node",
  "properties": {
    "token": {
      "description": "token",
      "type": "string"
    },
    "timestamp": {
      "description": "timestamp",
      "type": "string"
    },
    "prio": {
      "description": "prio",
      "type": "string"
    },
    "body": {
      "description": "body",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "acqAddr": {
          "description": "acqAddr",
          "type": "string",
          "minLength": 12,
          "maxLength": 12
        },
        "proType": {
          "description": "proType",
          "type": "string",
          "enum": ["00", "01", "02", "03"]
        },
        "required": ["acqAddr", "proType"]
      }
    }
  },
  "required": ["token", "timestamp", "prio", "body"],
  "type": "object"
}
