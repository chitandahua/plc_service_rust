{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mqtt server",
  "properties": {
    "Username": {
      "description": "Username",
      "type": "string"
    },
    "Password": {
      "description": "Password",
      "type": "string"
    },
    "ServiceIp": {
      "description": "ServiceIp",
      "type": "string",
      "format": "ipv4"
    },
    "ServicePort": {
      "description": "ServicePort",
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "ClientId": {
      "description": "ClientId",
      "type": "string"
    }
  },
  "required": ["Username", "Password", "ServiceIp", "ServicePort", "ClientId"],
  "type": "object"
}
